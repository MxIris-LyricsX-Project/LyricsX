    "AI Lyrics Translation" : {
      "comment" : "AI translation configuration title",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 歌词翻译" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "AI 歌詞翻譯" } }
      }
    },
    "When enabled, LyricsX translates lyric lines that do not already include the configured target language." : {
      "comment" : "AI translation configuration description",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用后，LyricsX 会翻译尚未包含所设目标语言译文的歌词行。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用後，LyricsX 會翻譯尚未包含所設目標語言譯文的歌詞行。" } }
      }
    },
    "Enter a new API key" : {
      "comment" : "AI translation API key placeholder",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入新的 API 密钥" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "輸入新的 API 金鑰" } }
      }
    },
    "The API key is stored in macOS Keychain and bound to this server. Changing to another server requires entering the key again. It is never written to LyricsX preferences or logs." : {
      "comment" : "AI translation Keychain security note",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API 密钥安全存储在 macOS 钥匙串中，并与此服务器绑定。切换到其他服务器后需要重新输入密钥。密钥不会写入 LyricsX 偏好设置或日志。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "API 金鑰安全儲存於 macOS 鑰匙圈，並與此伺服器綁定。切換到其他伺服器後需要重新輸入金鑰。金鑰不會寫入 LyricsX 偏好設定或日誌。" } }
      }
    },
    "Use the full Chat Completions endpoint. HTTPS is required except for localhost. Testing sends a minimal request using the configured model." : {
      "comment" : "AI translation endpoint security note",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请使用完整的 Chat Completions 端点。除 localhost 外必须使用 HTTPS。测试时会使用所配置的模型发送一个最小请求。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請使用完整的 Chat Completions 端點。除 localhost 外必須使用 HTTPS。測試時會使用所設定的模型傳送一個最小請求。" } }
      }
    },
    "Test" : {
