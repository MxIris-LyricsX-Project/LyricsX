    "Bluetooth compatibility depends on the phone. Song information and playback position are required. Cover art is shown when the phone supports it; seeking is not available." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth compatibility depends on the phone. Song information and playback position are required. Cover art is shown when the phone supports it; seeking is not available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能仍在试验中，兼容性取决于手机。手机须提供歌曲信息及播放进度；支持蓝牙封面的手机会显示封面，手机进度条仅供查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能仍在試驗中，相容性取決於手機。手機須提供歌曲資訊及播放進度；支援藍牙封面的手機會顯示封面，手機進度條僅供查看。"
          }
        }
      }
    },
